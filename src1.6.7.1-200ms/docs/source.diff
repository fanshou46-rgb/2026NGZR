-void RDFW::Plan() // 改
+void RDFW::CheckPlannerShutdown() const {
+    if (planner_active && planner_shutdown_generation.load() != active_planner_generation)
+        throw PlannerShutdown();
+}
+
+void RDFW::Plan() {
+    const std::uint64_t generation = planner_shutdown_generation.load();
+    std::unique_lock<std::mutex> lifetime(planner_lifecycle_mutex);
+    if (planner_shutdown_generation.load() != generation) return;
+    active_planner_generation = generation;
+    PlannerActiveGuard active(planner_active);
+    try {
+        PlanImpl();
+    } catch (const PlannerShutdown&) {
+        LOG("[Lifecycle] planner stopped after SDK shutdown request\n");
+    }
+}
