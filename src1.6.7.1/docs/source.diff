+class PlannerShutdown : public std::exception {
+public:
+    const char* what() const noexcept override { return "SDK requested planner shutdown"; }
+};
+
+class PlannerActiveGuard {
+public:
+    explicit PlannerActiveGuard(bool& active) : active_(active) { active_ = true; }
+    ~PlannerActiveGuard() { active_ = false; }
+private:
+    bool& active_;
+};
+
